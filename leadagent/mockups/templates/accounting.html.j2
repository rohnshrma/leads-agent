{# Accounting / tax firm mockup.
   Design concept: "the open ledger" - light ruled-paper hero with a rising chart line and floating
   document cards, a live tax-deadline countdown band, serif headings + number-style accents. #}
{% extends 'base.html.j2' %}
{% block css %}
.top{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}
.top .wrap{display:flex;align-items:center;gap:18px;min-height:70px}
.logo{display:flex;align-items:center;gap:10px;font:700 1.15rem/1.15 var(--font-h);text-decoration:none;min-width:200px;color:var(--primary)}
.logo .mark{display:grid;place-items:center;width:38px;height:38px;border-radius:8px;background:var(--primary);color:var(--on-primary);font:700 .95rem var(--font-h);flex:none}
.logo .t{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:1.02rem}
@media (max-width:720px){.logo .t{font-size:.9rem;line-height:1.15}}
.top nav{margin-left:auto;display:flex;gap:18px;font:500 .92rem var(--font-b);align-items:center}
.top nav a{text-decoration:none;color:var(--muted);padding:10px 0;white-space:nowrap}
.top nav a:hover{color:var(--ink)}
.top .portal{font-size:.86rem;color:var(--muted);border-left:1px solid var(--line);padding-left:18px;line-height:1.3;white-space:nowrap}
.top .portal .ph{white-space:nowrap}
.top .tel{font-weight:600;color:var(--primary);text-decoration:none;display:inline-flex;gap:6px;align-items:center;white-space:nowrap;min-height:44px}
.top .btn{padding:11px 18px;font-size:.9rem;white-space:nowrap}
@media (max-width:1240px){.top .portal{display:none}}
@media (max-width:1020px){.top nav .lk{display:none}}
@media (max-width:640px){.logo{min-width:0}.top .tel{display:none}.top nav{margin-left:auto}.top .btn{padding:11px 14px;font-size:.85rem}}

.hero{position:relative;overflow:hidden;background-color:var(--bg);
  background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:40px 40px;background-position:-1px -1px}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--bg) 20%,rgba(255,255,255,0) 75%);opacity:.92;pointer-events:none}
.hero .wrap{position:relative;display:grid;gap:24px;grid-template-columns:1.05fr .95fr;align-items:center;padding-top:64px;padding-bottom:64px}
.hero h1{font-size:clamp(2.2rem,5vw,3.6rem);font-weight:700;letter-spacing:-.015em;color:var(--primary)}
.hero .sub{font-size:1.15rem;color:var(--muted);margin:18px 0 28px;max-width:36ch}
.ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero .btn-ghost{color:var(--primary)}
.chips{display:flex;flex-wrap:wrap;gap:8px 10px;margin:28px 0 0;padding:0;list-style:none}
.chips li{display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:8px;background:var(--surface);border:1px solid var(--line);font:600 .85rem var(--font-b)}
.chips .ic{color:var(--primary)}
.art{width:100%;height:auto;display:block}
@media (max-width:900px){.hero .wrap{grid-template-columns:1fr;padding-top:44px;padding-bottom:36px}.hero::before{background:linear-gradient(180deg,var(--bg) 35%,rgba(255,255,255,0) 100%)}.art{max-width:480px;margin:0 auto}}

.dl{background:var(--primary);color:var(--on-primary);padding:30px 0}
.dl .wrap{display:grid;grid-template-columns:auto 1fr auto;gap:12px 32px;align-items:center}
.dl .big{font:700 clamp(3rem,7vw,4.6rem)/1 var(--font-h);color:var(--accent);font-variant-numeric:tabular-nums;min-width:2ch}
.dl .big small{display:block;font:600 .74rem/1.2 var(--font-b);letter-spacing:.12em;text-transform:uppercase;color:var(--on-primary);opacity:.8;margin-top:6px}
.dl h2{font-size:1.4rem;font-weight:600}
.dl p{opacity:.85;font-size:.9rem;margin-top:6px;max-width:60ch}
.dl .btn{white-space:nowrap}
@media (max-width:820px){.dl .wrap{grid-template-columns:auto 1fr}.dl .btn{grid-column:1/-1}}

.svc{display:grid;gap:0;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--surface);grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr))}
.svc .it{padding:26px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);margin:0 -1px -1px 0;position:relative;display:grid;gap:10px;align-content:start}
.svc .no{font:600 .8rem var(--font-h);color:var(--muted);letter-spacing:.06em}
.svc .it .icon-badge{border-radius:50%;width:44px;height:44px}
.svc h3{font-size:1.1rem;font-weight:600}
.svc p{color:var(--muted);font-size:.95rem}
.svc .it:hover{background:var(--tint)}

.who-wrap{background:var(--tint)}
.who-in{position:absolute;opacity:0;pointer-events:none}
.tiles{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))}
.tile{display:flex;align-items:center;gap:14px;padding:18px;min-height:64px;background:var(--surface);border:2px solid var(--line);border-radius:var(--radius);cursor:pointer;font:600 1.02rem var(--font-h)}
.tile .icon-badge{width:42px;height:42px}
.who-out{margin-top:20px;background:var(--surface);border-left:4px solid var(--accent);border-radius:8px;padding:20px 24px;font-size:1.08rem;max-width:760px}
.who-out p{display:none}
.who-in:focus-visible + *{outline:none}
{% for i in range(4) %}#w{{ i }}:checked ~ .tiles label[for=w{{ i }}]{border-color:var(--primary);background:var(--primary);color:var(--on-primary)}
#w{{ i }}:checked ~ .tiles label[for=w{{ i }}] .icon-badge{background:var(--accent);color:var(--on-accent)}
#w{{ i }}:focus-visible ~ .tiles label[for=w{{ i }}]{outline:3px solid var(--accent);outline-offset:3px}
#w{{ i }}:checked ~ .who-out .p{{ i }}{display:block}
{% endfor %}

.steps{list-style:none;margin:0;padding:0;display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));counter-reset:s}
.steps li{counter-increment:s;border-top:3px solid var(--primary);padding-top:18px}
.steps li::before{content:"0" counter(s);display:block;font:700 2.6rem/1 var(--font-h);color:var(--accent);margin-bottom:10px;-webkit-text-stroke:0}
.steps h3{font-size:1.15rem;margin-bottom:6px}
.steps p{color:var(--muted)}

.bring-wrap{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.bring{display:grid;gap:32px;grid-template-columns:1.1fr .9fr;align-items:start}
@media (max-width:860px){.bring{grid-template-columns:1fr}}
.paper{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:0 24px}
.paper ul{list-style:none;margin:0;padding:0}
.paper li{display:flex;gap:14px;align-items:center;min-height:52px;font-weight:500;border-bottom:1px solid var(--line)}
.paper li:last-child{border-bottom:0}
.paper .box{width:22px;height:22px;border:2px solid var(--primary);border-radius:5px;flex:none;display:grid;place-items:center;color:var(--primary);font-size:.85rem}
.secure{border:2px dashed var(--line);border-radius:var(--radius);padding:26px;display:grid;gap:12px;background:var(--bg)}
.secure h3{font-size:1.2rem}
.secure p{color:var(--muted)}

.own{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}
.own .card{display:grid;gap:10px;align-content:start}
.own h3{font-size:1.1rem}
.own .lbl{font:700 .74rem/1 var(--font-b);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.own .slot{display:flex;gap:10px;align-items:center}
.own .avatar{width:52px;height:52px;border-radius:50%;background:var(--tint);border:2px dashed var(--line);flex:none}

.contact{background:var(--tint)}
{% endblock %}

{% block body %}
{% set who_text = ["Get your return prepared accurately, with clear answers and no jargon.", "Keep the books tidy so tax time and decisions are easier.", "Stay organised through the year, including estimated payments and expenses.", "Get help keeping records and filings in order so you can focus on your mission."] %}
<header class="top">
  <div class="wrap">
    <a class="logo" href="#top"><span class="mark">{{ b.initials }}</span><span class="t">{{ b.name }}</span></a>
    <nav aria-label="Main">
      <a class="lk" href="#services">Services</a><a class="lk" href="#who">Who we help</a><a class="lk" href="#steps">How it works</a><a class="lk" href="#faq">FAQ</a>
      <span class="portal">{{ n.extras.portal_placeholder|rich }}</span>
      {% if b.phone_tel %}<a class="tel" href="tel:{{ b.phone_tel }}">{{ icon('phone') }}{{ b.phone }}</a>{% endif %}
      <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
    </nav>
  </div>
</header>

<div class="hero" id="top">
  <div class="wrap">
    <div>
      <h1>{{ n.h1 }}</h1>
      <p class="sub">{{ n.sub }}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contact">{{ n.cta_primary }}</a>
        {% if b.phone_tel %}<a class="btn btn-ghost" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} {{ n.cta_secondary }}</a>{% endif %}
      </div>
      <ul class="chips">{% for c in n.chips %}<li>{{ icon('check') }}{{ c }}</li>{% endfor %}</ul>
    </div>
    <svg class="art" viewBox="0 0 520 400" role="img" aria-label="Abstract illustration of a rising chart and documents">
      <rect x="20" y="30" width="480" height="340" rx="18" fill="{{ pal.surface }}" stroke="{{ pal.line }}" stroke-width="2"/>
      <g stroke="{{ pal.line }}" stroke-width="1.5">
        <path d="M50 110H470M50 170H470M50 230H470M50 290H470"/>
      </g>
      <g fill="{{ pal.tint }}"><rect x="70" y="240" width="34" height="80"/><rect x="130" y="210" width="34" height="110"/><rect x="190" y="225" width="34" height="95"/><rect x="250" y="180" width="34" height="140"/><rect x="310" y="150" width="34" height="170"/><rect x="370" y="120" width="34" height="200"/><rect x="430" y="90" width="34" height="230"/></g>
      <path d="M50 320H470" stroke="{{ pal.primary }}" stroke-width="3"/>
      <path d="M60 290 L127 250 L194 262 L260 200 L327 178 L394 130 L455 96" fill="none" stroke="{{ pal.primary }}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <g fill="{{ pal.accent }}" stroke="{{ pal.surface }}" stroke-width="3"><circle cx="127" cy="250" r="8"/><circle cx="260" cy="200" r="8"/><circle cx="394" cy="130" r="8"/><circle cx="455" cy="96" r="11"/></g>
      <g transform="rotate(-6 90 90)"><rect x="34" y="52" width="150" height="104" rx="10" fill="{{ pal.primary }}"/><rect x="52" y="72" width="70" height="8" rx="4" fill="{{ pal.accent }}"/><rect x="52" y="92" width="114" height="6" rx="3" fill="#fff" opacity=".6"/><rect x="52" y="108" width="96" height="6" rx="3" fill="#fff" opacity=".6"/><rect x="52" y="124" width="106" height="6" rx="3" fill="#fff" opacity=".6"/></g>
      <g transform="rotate(5 420 320)"><rect x="330" y="290" width="150" height="86" rx="10" fill="{{ pal.surface }}" stroke="{{ pal.primary }}" stroke-width="2.5"/><circle cx="360" cy="320" r="12" fill="{{ pal.tint }}"/><path d="M354 320 l5 5 l9 -10" fill="none" stroke="{{ pal.primary }}" stroke-width="3" stroke-linecap="round"/><rect x="382" y="312" width="80" height="7" rx="3.5" fill="{{ pal.primary }}" opacity=".8"/><rect x="382" y="328" width="56" height="6" rx="3" fill="{{ pal.line }}"/><rect x="346" y="348" width="118" height="6" rx="3" fill="{{ pal.line }}"/></g>
    </svg>
  </div>
</div>

<div class="dl" id="deadlines">
  <div class="wrap">
    <div class="big"><span id="dl-days">&ndash;</span><small>days to go</small></div>
    <div>
      <h2>Next common federal tax date: <span id="dl-date">April 15</span></h2>
      <p>Dates shift when they fall on a weekend or holiday - confirm for the current year.</p>
    </div>
    <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
  </div>
</div>
<script>
(function(){try{
  var D=[[0,15],[2,15],[3,15],[5,15],[8,15],[9,15]],M=["January","March","April","June","September","October"];
  var M2=["January","February","March","April","May","June","July","August","September","October","November","December"];
  var now=new Date(),t=new Date(now.getFullYear(),now.getMonth(),now.getDate()),best=null;
  for(var y=t.getFullYear();y<=t.getFullYear()+1&&!best;y++){for(var i=0;i<D.length;i++){var d=new Date(y,D[i][0],D[i][1]);if(d>=t){best=d;break;}}}
  var days=Math.round((best-t)/864e5);
  document.getElementById("dl-days").textContent=days;
  document.getElementById("dl-date").textContent=M2[best.getMonth()]+" "+best.getDate();
}catch(e){}})();
</script>

<section id="services">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">What we do</span><h2>{{ n.services_title }}</h2><p>Illustrative list of services. {{ '[[Confirm the services you offer]]'|rich }}</p></div>
    <div class="svc">
      {% for ic, t, d in n.services %}
      <div class="it"><span class="no">{{ '%02d'|format(loop.index) }}</span><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ t }}</h3><p>{{ d }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="who-wrap" id="who">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Fit</span><h2>{{ n.extras.who_title }}</h2><p>Choose a group to see how the firm can help.</p></div>
    <div>
      {% for ic, label in n.extras.who %}<input class="who-in" type="radio" name="who" id="w{{ loop.index0 }}"{% if loop.first %} checked{% endif %} aria-label="{{ label }}">{% endfor %}
      <div class="tiles">
        {% for ic, label in n.extras.who %}<label class="tile" for="w{{ loop.index0 }}"><span class="icon-badge">{{ icon(ic) }}</span>{{ label }}</label>{% endfor %}
      </div>
      <div class="who-out" aria-live="polite">
        {% for ic, label in n.extras.who %}<p class="p{{ loop.index0 }}">{{ who_text[loop.index0] if loop.index0 < 4 else 'Practical, clear help for ' ~ label|lower ~ '.' }}</p>{% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="steps">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Process</span><h2>{{ n.steps_title }}</h2></div>
    <ol class="steps">
      {% for t, d in n.steps %}<li><h3>{{ t }}</h3><p>{{ d|rich }}</p></li>{% endfor %}
    </ol>
  </div>
</section>

<section class="bring-wrap" id="bring">
  <div class="wrap">
    <div class="bring">
      <div>
        <div class="sec-head" style="margin-bottom:22px"><span class="eyebrow">Get ready</span><h2>{{ n.extras.checklist_title }}</h2></div>
        <div class="paper"><ul>{% for c in n.extras.checklist %}<li><span class="box">{{ icon('check') }}</span>{{ c|rich }}</li>{% endfor %}</ul></div>
      </div>
      <div class="secure">
        <span class="icon-badge">{{ icon('lock') }}</span>
        <h3>Secure document exchange</h3>
        <p>Please avoid emailing sensitive documents such as ID or tax forms.</p>
        <p>{{ '[[Add your secure upload / portal details]]'|rich }}</p>
      </div>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">About the firm</span><h2>{{ b.name }}</h2></div>
    <div class="own">
      <div class="card"><span class="lbl">Our story</span><h3>{{ n.extras.since_placeholder|rich }}</h3><p style="color:var(--muted)">{{ '[[Add a short introduction to your firm]]'|rich }}</p></div>
      <div class="card"><span class="lbl">Team</span><div class="slot"><span class="avatar"></span><div>{{ '[[Owner / preparer name and role]]'|rich }}</div></div><p style="color:var(--muted)">{{ '[[Add team member details]]'|rich }}</p></div>
      <div class="card"><span class="lbl">Client reviews</span><p>{{ '[[Add real client reviews here]]'|rich }}</p><p style="color:var(--muted);font-size:.9rem">Only genuine, permitted reviews should appear here.</p></div>
    </div>
  </div>
</section>

<section id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Questions</span><h2>Frequently asked questions</h2></div>
    {{ m.faq(n.faq) }}
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Contact</span><h2>{{ n.cta_primary }}</h2><p>Tell us a little about your situation and we will follow up.</p></div>
    <div class="contact-grid">
      <div>{{ m.info_list(b) }}{{ m.map_block(b) }}</div>
      <div class="card">{{ m.preview_form(n.cta_primary, matters=["Individual tax return","Business tax return","Bookkeeping","Payroll","Something else"], matter_label="What do you need help with?") }}</div>
    </div>
  </div>
</section>
{% endblock %}
