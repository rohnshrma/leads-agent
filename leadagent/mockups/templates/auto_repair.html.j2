{# Auto repair: "the garage" - condensed industrial type, hazard-stripe accents, gear + car-silhouette hero, phone number as the loudest element. #}
{% extends 'base.html.j2' %}
{% block css %}
/* ===== Auto repair: garage / workshop ===== */
h1,h2,h3{text-transform:uppercase;letter-spacing:.01em}
.sec-head h2{font-weight:800;font-size:clamp(2rem,4.4vw,3rem)}
.eyebrow{color:var(--accent);font-weight:800}
.stripe{height:12px;background:repeating-linear-gradient(-45deg,var(--accent) 0 14px,var(--primary) 14px 28px)}

/* header: phone is the biggest element */
.top{background:var(--primary);color:var(--on-primary);position:sticky;top:0;z-index:40;border-bottom:4px solid var(--accent)}
.top .wrap{display:flex;align-items:center;gap:18px;min-height:74px}
.logo{display:flex;align-items:center;gap:10px;font:800 1.25rem/1.05 var(--font-h);text-transform:uppercase;text-decoration:none;min-width:0;letter-spacing:.02em}
.logo .mark{display:grid;place-items:center;width:40px;height:40px;background:var(--accent);color:var(--on-accent);flex:none;font-size:1.25rem;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%)}
.logo .t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.top nav{margin-left:auto;display:flex;gap:20px;font:600 .9rem var(--font-b)}
.top nav a{text-decoration:none;opacity:.85;padding:10px 0}
.top nav a:hover{opacity:1;color:var(--accent)}
.top .tel{display:flex;align-items:center;gap:8px;font:800 clamp(1.5rem,2.6vw,2.1rem)/1 var(--font-h);text-decoration:none;white-space:nowrap;letter-spacing:.02em;min-height:44px}
.top .tel .ic{color:var(--accent)}
.top .btn{padding:12px 20px;font-size:.92rem;white-space:nowrap;border-radius:4px;text-transform:uppercase;letter-spacing:.05em}
.top .spacer{margin-left:auto}
@media (max-width:1000px){.top nav{display:none}.top .tel{margin-left:auto}}
@media (max-width:640px){.top .btn{display:none}.top .tel{font-size:1.45rem}.logo{font-size:1.05rem}.logo .mark{width:34px;height:34px}}
@media (max-width:440px){.logo .mark{display:none}.logo{font-size:1rem;flex:1 1 0}.top .tel{font-size:1.3rem}}

.btn{border-radius:4px;text-transform:uppercase;letter-spacing:.05em;min-height:48px}

/* hero */
.hero{background:var(--primary);color:var(--on-primary);position:relative;overflow:hidden;
  background-image:repeating-linear-gradient(-45deg,rgba(255,255,255,.035) 0 2px,transparent 2px 22px)}
.hero .wrap{display:grid;gap:24px;grid-template-columns:1.05fr .95fr;align-items:center;padding-top:56px;padding-bottom:48px}
.open{display:inline-flex;align-items:center;gap:10px;font:700 .86rem/1.3 var(--font-b);padding:8px 14px;border:1px solid rgba(255,255,255,.3);border-radius:4px;margin-bottom:22px}
.open i{width:10px;height:10px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 4px rgba(34,197,94,.25);flex:none}
.hero h1{font-size:clamp(2.9rem,7.4vw,5.6rem);font-weight:800;line-height:.98;letter-spacing:.005em}
.hero .sub{font-size:1.15rem;opacity:.92;margin:18px 0 26px;max-width:36ch}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero .btn-call{font:800 1.5rem/1 var(--font-h);padding:14px 26px}
.hero .btn-ghost{color:#fff}
.hero .where{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:22px;font-size:.95rem;opacity:.95}
.hero .where span{display:inline-flex;gap:8px;align-items:center}
.hero .where .ic{color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0 0;padding:0;list-style:none}
.chips li{display:flex;align-items:center;gap:8px;padding:8px 14px;background:rgba(255,255,255,.08);border-left:4px solid var(--accent);font:600 .88rem var(--font-b)}
.chips .ic{color:var(--accent)}
.rig{width:100%;height:auto;display:block}
.gear-a{transform-origin:150px 150px;animation:spin 40s linear infinite}
.gear-b{transform-origin:340px 92px;animation:spin 26s linear infinite reverse}
@keyframes spin{to{transform:rotate(360deg)}}
@media (max-width:900px){.hero .wrap{grid-template-columns:1fr;padding-top:36px}.rig{max-width:520px;margin:0 auto}}
@media (max-width:480px){.hero .btn{width:100%}}

/* check engine strip */
.alert{background:var(--accent);color:var(--on-accent)}
.alert .wrap{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;padding-top:18px;padding-bottom:18px}
.alert .lamp{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--on-accent);color:var(--accent);font-size:1.6rem;flex:none}
.alert h2{font-size:clamp(1.5rem,3vw,2.1rem);font-weight:800}
.alert p{font-size:.98rem;margin-top:2px}
.alert .txt{flex:1 1 280px}
.alert .btn{background:var(--on-accent);color:var(--accent);border-color:var(--on-accent)}
.alert .btn:hover{box-shadow:0 8px 20px -8px rgba(0,0,0,.5)}

/* services */
.svc{gap:16px}
.svc .card{border-radius:4px;border-top:4px solid var(--line);display:grid;gap:10px;align-content:start;transition:transform .18s,box-shadow .18s,border-color .18s,background .18s}
.svc .card:hover{transform:translateY(-4px);border-top-color:var(--accent);box-shadow:0 16px 30px -20px rgba(0,0,0,.5)}
.svc .card:hover .icon-badge{background:var(--accent);color:var(--on-accent)}
.svc .icon-badge{border-radius:4px;transition:background .18s,color .18s}
.svc h3{font-size:1.4rem;font-weight:700}
.svc p{color:var(--muted);font-size:.95rem}

/* why */
.why-wrap{background:var(--primary);color:var(--on-primary)}
.why-wrap .sec-head p{color:inherit;opacity:.85}
.why-grid{display:grid;gap:0;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));border:1px solid rgba(255,255,255,.18)}
.why-grid>div{padding:28px 26px;border-right:1px solid rgba(255,255,255,.18);border-bottom:1px solid rgba(255,255,255,.18);margin:0 -1px -1px 0}
.why-grid .icon-badge{background:var(--accent);color:var(--on-accent);border-radius:4px}
.why-grid h3{font-size:1.5rem;margin:16px 0 6px;font-weight:700}
.why-grid p{opacity:.9}
.why-grid .ph{opacity:1}

/* steps */
.steps{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));counter-reset:s}
.steps li{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:26px 22px 44px;overflow:hidden}
.steps li::before{counter-increment:s;content:"0" counter(s);position:absolute;right:12px;bottom:-14px;font:800 4.6rem/1 var(--font-h);color:var(--tint)}
.steps li>*{position:relative;z-index:1}
.steps h3{font-size:1.5rem;margin-bottom:8px;font-weight:700}
.steps p{color:var(--muted);font-size:.96rem}
.steps li::after{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent)}
.promise{margin-top:22px;display:flex;gap:12px;align-items:flex-start;padding:16px 20px;background:var(--tint);border-left:5px solid var(--primary);border-radius:0 4px 4px 0;font-weight:600;max-width:820px}
.promise .ic{color:var(--accent);font-size:1.4rem;margin-top:.1em}

/* makes + extras */
.makes-wrap{background:var(--tint)}
.makes{display:flex;flex-wrap:wrap;align-items:center;gap:14px 30px;padding:18px 0 34px;border-bottom:2px solid var(--line);margin-bottom:34px}
.makes .lbl{font:800 .8rem/1 var(--font-b);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.makes .list{font:800 clamp(1.7rem,4vw,2.8rem)/1.1 var(--font-h);text-transform:uppercase;color:var(--primary)}
.extras{display:grid;gap:18px;grid-template-columns:1.3fr 1fr 1fr 1fr}
.extras .card{border-radius:4px;display:grid;gap:10px;align-content:start}
.extras h3{font-size:1.3rem;font-weight:700}
.extras .reminder{background:var(--primary);color:var(--on-primary);border-color:var(--primary)}
.extras .reminder .icon-badge{background:var(--accent);color:var(--on-accent);border-radius:4px}
.extras .reminder p{opacity:.95}
.extras .slot{border-style:dashed;border-width:2px;background:transparent}
.extras .slot small{font:700 .7rem/1 var(--font-b);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.extras .slot .body{font-size:1.02rem;font-weight:600}
@media (max-width:980px){.extras{grid-template-columns:1fr 1fr}.extras .reminder{grid-column:1/-1}}
@media (max-width:560px){.extras{grid-template-columns:1fr}}

/* CTA band + contact */
.band{background:var(--primary);color:var(--on-primary);text-align:center;padding:64px 0;position:relative;overflow:hidden;
  background-image:repeating-linear-gradient(-45deg,rgba(255,255,255,.035) 0 2px,transparent 2px 22px)}
.band h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;opacity:.92}
.band .big{display:inline-block;font:800 clamp(3rem,11vw,7rem)/1 var(--font-h);color:var(--on-primary);text-decoration:none;margin:10px 0 18px;letter-spacing:.02em;border-bottom:6px solid var(--accent)}
.band p{opacity:.85;max-width:52ch;margin:0 auto 22px}
.contact{background:var(--tint)}
.tips{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.tips li{display:flex;gap:12px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:14px 16px;font-weight:500}
.tips .ic{color:var(--accent);margin-top:.2em}
.contact .card{border-radius:4px;border-top:5px solid var(--accent)}
{% endblock %}

{% block body %}
<header class="top">
  <div class="wrap">
    <a class="logo" href="#top" aria-label="{{ b.name }}"><span class="mark">{{ icon('wrench') }}</span><span class="t">{{ b.name }}</span></a>
    <nav aria-label="Main"><a href="#services">Services</a><a href="#how">How it works</a><a href="#visit">Visit</a><a href="#faq">FAQ</a><a href="#contact">Contact</a></nav>
    {% if b.phone_tel %}<a class="tel" href="tel:{{ b.phone_tel }}" aria-label="Call {{ b.phone }}">{{ icon('phone') }}{{ b.phone }}</a>{% else %}<span class="spacer"></span>{% endif %}
    <a class="btn btn-accent" href="#contact">Book service</a>
  </div>
</header>

<div class="hero" id="top">
  <div class="wrap">
    <div>
      <div class="open"><i aria-hidden="true"></i><span>{{ '[[Open now - add your hours]]'|rich }}</span></div>
      <h1>{{ n.h1 }}</h1>
      <p class="sub">{{ n.sub }}</p>
      <div class="ctas">
        {% if b.phone_tel %}<a class="btn btn-accent btn-call" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} {{ b.phone }}</a>{% endif %}
        <a class="btn {{ 'btn-ghost' if b.phone_tel else 'btn-accent' }}" href="#contact">{{ n.cta_primary }}</a>
      </div>
      {% if b.address %}<div class="where"><span>{{ icon('pin') }}{{ b.address }}</span></div>{% endif %}
      <ul class="chips">{% for c in n.chips %}<li>{{ icon('check') }}{{ c }}</li>{% endfor %}</ul>
    </div>

    <svg class="rig" viewBox="0 0 520 400" role="img" aria-label="Illustration of a car with gears and a wrench">
      <g class="gear-a">
        {% for a in range(0, 360, 30) %}<rect x="136" y="18" width="28" height="34" rx="4" fill="{{ pal.accent }}" transform="rotate({{ a }} 150 150)"/>{% endfor %}
        <circle cx="150" cy="150" r="106" fill="{{ pal.accent }}"/>
        <circle cx="150" cy="150" r="84" fill="none" stroke="#000" stroke-opacity=".18" stroke-width="3" stroke-dasharray="6 10"/>
        <circle cx="150" cy="150" r="34" fill="{{ pal.primary }}"/>
        <circle cx="150" cy="150" r="14" fill="{{ pal.accent }}"/>
      </g>
      <g class="gear-b" opacity=".85">
        {% for a in range(0, 360, 45) %}<rect x="330" y="20" width="20" height="24" rx="3" fill="#fff" fill-opacity=".9" transform="rotate({{ a }} 340 92)"/>{% endfor %}
        <circle cx="340" cy="92" r="60" fill="#fff" fill-opacity=".9"/>
        <circle cx="340" cy="92" r="22" fill="{{ pal.primary }}"/>
      </g>
      <g transform="rotate(-38 440 250)" fill="#fff" fill-opacity=".92">
        <rect x="428" y="200" width="24" height="150" rx="10"/>
        <path d="M414 208 v-40 a24 24 0 0 1 22-22 v20 h8 v-20 a24 24 0 0 1 22 22 v40z"/>
      </g>
      <rect x="0" y="352" width="520" height="8" fill="{{ pal.accent }}"/>
      <rect x="0" y="360" width="520" height="40" fill="#000" fill-opacity=".28"/>
      <g stroke="#fff" stroke-opacity=".35" stroke-width="4" stroke-dasharray="26 22"><path d="M-10 380 H530"/></g>
      <g transform="translate(46 196)">
        <path d="M0 132 V96 c0-12 8-20 20-24 l58-14 c10-24 26-38 54-38 h70 c26 0 42 12 58 34 l50 10 c22 5 34 16 34 36 v34 h-28 a38 38 0 0 0-76 0 H126 a38 38 0 0 0-76 0z" fill="#fff" fill-opacity=".96"/>
        <path d="M98 56 c8-16 18-24 38-24 h56 v28z M204 32 h16 c14 0 24 8 34 26 l-50 2z" fill="{{ pal.primary }}" fill-opacity=".85"/>
        <rect x="-2" y="88" width="16" height="12" rx="3" fill="{{ pal.accent }}"/>
        <circle cx="88" cy="134" r="34" fill="#12151a"/><circle cx="88" cy="134" r="15" fill="#cbd5e1"/><circle cx="88" cy="134" r="5" fill="#12151a"/>
        <circle cx="256" cy="134" r="34" fill="#12151a"/><circle cx="256" cy="134" r="15" fill="#cbd5e1"/><circle cx="256" cy="134" r="5" fill="#12151a"/>
      </g>
    </svg>
  </div>
  <div class="stripe"></div>
</div>

<div class="alert">
  <div class="wrap">
    <span class="lamp">{{ icon('gauge') }}</span>
    <div class="txt"><h2>Check engine light on?</h2><p>Warning light, strange noise or a car that just does not feel right? Tell us what it is doing.</p></div>
    <a class="btn" href="#contact">{{ n.cta_primary }} {{ icon('arrow') }}</a>
  </div>
</div>

<section id="services">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Services</span><h2>{{ n.services_title }}</h2>
      <p>{{ '[[Edit this list to match the work your shop actually does]]'|rich }}</p></div>
    <div class="grid grid-4 svc">
      {% for ic, title, desc in n.services %}
      <div class="card"><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="why-wrap">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Why us</span><h2>{{ n.extras.why_title }}</h2></div>
    <div class="why-grid">
      {% for ic, title, desc in n.extras.why %}
      <div><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc|rich }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="how">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">The process</span><h2>{{ n.steps_title }}</h2>
      <p>No surprises: you know what is wrong and what it costs before any work starts.</p></div>
    <ol class="steps">
      {% for title, desc in n.steps %}<li><h3>{{ title }}</h3><p>{{ desc|rich }}</p></li>{% endfor %}
    </ol>
    <div class="promise">{{ icon('shield') }}<span>No work starts until you have said yes. {{ '[[Confirm your approval policy]]'|rich }}</span></div>
  </div>
</section>

<section class="makes-wrap">
  <div class="wrap">
    <div class="makes"><span class="lbl">Vehicles we service</span><span class="list">{{ n.extras.makes }}</span><span>{{ '[[Confirm makes you service]]'|rich }}</span></div>
    <div class="extras">
      <div class="card reminder"><span class="icon-badge">{{ icon('oil') }}</span><h3>Service reminder</h3><p>{{ n.extras.reminder }}</p></div>
      <div class="card slot"><small>Owner supplied</small><h3>Current special</h3><div class="body">{{ n.extras.special_placeholder|rich }}</div></div>
      <div class="card slot"><small>Owner supplied</small><h3>Financing</h3><div class="body">{{ n.extras.financing_placeholder|rich }}</div></div>
      <div class="card slot"><small>Owner supplied</small><h3>Certifications</h3><div class="body">{{ n.extras.badges_placeholder|rich }}</div></div>
    </div>
  </div>
</section>

<section id="visit">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Visit the shop</span><h2>Hours &amp; location</h2></div>
    <div class="contact-grid">
      <div>{{ m.info_list(b, hours="[[Add your hours]]") }}</div>
      <div style="margin-top:-22px">{{ m.map_block(b) }}</div>
    </div>
  </div>
</section>

<section id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Questions</span><h2>Frequently asked questions</h2></div>
    {{ m.faq(n.faq) }}
  </div>
</section>

<div class="band">
  <div class="wrap">
    <h2>Car trouble? Call the shop.</h2>
    {% if b.phone_tel %}<a class="big" href="tel:{{ b.phone_tel }}">{{ b.phone }}</a>{% else %}<div class="big" style="border:0">{{ b.name }}</div>{% endif %}
    <p>{% if b.address %}{{ b.address }}{% else %}Serving {{ b.city_state }}{% endif %}. Or send a request below and we will get back to you.</p>
    <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
  </div>
</div>
<div class="stripe"></div>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Book service</span><h2>Request an appointment</h2>
      <p>Tell us about your car and what it is doing, and we will follow up.</p></div>
    <div class="contact-grid">
      <div>
        <h3 style="font-size:1.6rem;margin-bottom:14px">Helpful to tell us</h3>
        <ul class="tips">
          <li>{{ icon('car') }}<span>Year, make and model of your vehicle</span></li>
          <li>{{ icon('alert') }}<span>Any warning lights, noises or smells</span></li>
          <li>{{ icon('calendar') }}<span>When you would like to drop it off</span></li>
        </ul>
      </div>
      <div class="card">{{ m.preview_form('Request appointment', matters=['Brakes','Check engine light / diagnostics','Oil change / maintenance','Tires & alignment','A/C & heating','Something else'], matter_label='What does your car need?') }}</div>
    </div>
  </div>
</section>
{% endblock %}
