{% extends 'base.html.j2' %}
{% block css %}
/* ===== Driving school: "learn the road" - navy/sign-yellow, road & step motifs ===== */
.top{background:var(--primary);color:var(--on-primary);position:sticky;top:0;z-index:40}
.top .wrap{display:flex;align-items:center;gap:20px;min-height:68px}
.logo{display:flex;align-items:center;gap:10px;font:800 1.1rem/1.1 var(--font-h);text-decoration:none;min-width:0}
.logo .mark{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--accent);color:var(--on-accent);flex:none;font-size:1.2rem}
.logo span.t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.top nav{margin-left:auto;display:flex;gap:22px;font:600 .92rem var(--font-b)}
.top nav a{text-decoration:none;opacity:.85}
.top nav a:hover{opacity:1}
.top .btn{padding:10px 18px;font-size:.92rem;white-space:nowrap}
@media (max-width:860px){.top nav{display:none}.top .btn{margin-left:auto}}

.hero{background:var(--primary);color:var(--on-primary);padding:56px 0 0;position:relative;overflow:hidden}
.hero .wrap{display:grid;gap:32px;grid-template-columns:1.1fr .9fr;align-items:center;padding-bottom:40px}
.hero h1{font-size:clamp(2.2rem,5.4vw,3.8rem);font-weight:800;letter-spacing:-.02em}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero .sub{font-size:1.18rem;opacity:.9;margin:18px 0 28px;max-width:34ch}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 0;padding:0;list-style:none}
.chips li{display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;border:1px solid rgba(255,255,255,.28);font:600 .86rem var(--font-b)}
.chips .ic{color:var(--accent)}
.scene{width:100%;height:auto;display:block;margin-bottom:-2px}
@media (max-width:860px){.hero .wrap{grid-template-columns:1fr;padding-bottom:0}.scene{max-width:520px;margin:0 auto -2px}}
.roadline{height:14px;background:repeating-linear-gradient(90deg,var(--accent) 0 38px,transparent 38px 76px);opacity:.9}

.strip{background:var(--tint);border-bottom:1px solid var(--line)}
.strip .wrap{display:flex;flex-wrap:wrap;gap:12px 36px;padding-top:16px;padding-bottom:16px;font-weight:600;font-size:.95rem}
.strip span{display:inline-flex;gap:8px;align-items:center}
.strip .ic{color:var(--primary)}

.svc{display:grid;gap:14px}
.svc .card{display:grid;gap:12px;align-content:start;transition:transform .18s,box-shadow .18s}
.svc .card:hover{transform:translateY(-3px);box-shadow:0 14px 30px -18px rgba(15,42,74,.4)}
.svc h3{font-size:1.08rem}
.svc p{color:var(--muted);font-size:.95rem}

.steps{list-style:none;margin:0;padding:0;display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));counter-reset:s;position:relative}
.steps li{position:relative;padding-top:64px}
.steps li::before{counter-increment:s;content:counter(s);position:absolute;top:0;left:0;width:48px;height:48px;border-radius:50%;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;font:800 1.2rem var(--font-h);z-index:1;box-shadow:0 0 0 6px var(--bg)}
.steps li::after{content:"";position:absolute;top:23px;left:56px;right:-12px;border-top:3px dashed var(--line)}
.steps li:last-child::after{display:none}
.steps h3{font-size:1.1rem;margin-bottom:6px}
.steps p{color:var(--muted);font-size:.95rem}
@media (max-width:640px){.steps li::after{display:none}}

.pkg-wrap{background:var(--tint)}
.pkg{display:flex;flex-direction:column;gap:10px;position:relative}
.pkg .hrs{font:800 2rem/1 var(--font-h);color:var(--primary)}
.pkg .price{color:var(--muted);font-weight:600}
.pkg.pop{border:2px solid var(--primary);box-shadow:0 18px 40px -24px var(--primary)}
.pkg .tag{position:absolute;top:-13px;left:22px;background:var(--accent);color:var(--on-accent);font:800 .72rem/1 var(--font-b);letter-spacing:.08em;text-transform:uppercase;padding:7px 12px;border-radius:999px}
.pkg .btn{margin-top:auto}

.why .icon-badge{background:var(--primary);color:var(--on-primary)}
.why h3{margin:14px 0 6px;font-size:1.12rem}
.why p{color:var(--muted)}

.check{display:grid;gap:36px;grid-template-columns:.9fr 1.1fr;align-items:center}
.check ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.check li{display:flex;gap:12px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px;font-weight:500}
.check li .ic{color:#16A34A;margin-top:.15em}
@media (max-width:820px){.check{grid-template-columns:1fr}}

.contact{background:var(--tint)}
{% endblock %}

{% block body %}
<header class="top">
  <div class="wrap">
    <a class="logo" href="#top"><span class="mark">{{ icon('car') }}</span><span class="t">{{ b.name }}</span></a>
    <nav aria-label="Main"><a href="#lessons">Lessons</a><a href="#steps">How it works</a><a href="#packages">Packages</a><a href="#faq">FAQ</a><a href="#contact">Contact</a></nav>
    <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
  </div>
</header>

<div class="hero" id="top">
  <div class="wrap">
    <div>
      <h1>{{ n.h1 }}</h1>
      <p class="sub">{{ n.sub }}</p>
      <div class="ctas">
        <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
        {% if b.phone_tel %}<a class="btn btn-ghost" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} {{ n.cta_secondary }}</a>{% endif %}
      </div>
      <ul class="chips">
        {% for c in n.chips %}<li>{{ icon('check') }}{{ c }}</li>{% endfor %}
      </ul>
    </div>
    <svg class="scene" viewBox="0 0 520 340" role="img" aria-label="Illustration of a learner car on the road">
      <circle cx="410" cy="92" r="46" fill="{{ pal.accent }}" opacity=".95"/>
      <path d="M0 250 L120 190 L210 236 L320 170 L430 232 L520 196 V300 H0Z" fill="#fff" opacity=".08"/>
      <rect y="262" width="520" height="78" fill="#0a1a30" opacity=".55"/>
      <rect y="262" width="520" height="6" fill="#fff" opacity=".18"/>
      <g stroke="{{ pal.accent }}" stroke-width="6" stroke-linecap="round" stroke-dasharray="34 30"><path d="M-10 306 H530"/></g>
      <g transform="translate(96 168)">
        <path d="M6 78 V52 c0-8 6-14 14-16 l40-10 c6-14 16-24 34-24 h58 c16 0 26 8 34 22 l24 8 c14 2 22 10 22 22 v26 h-14 a26 26 0 0 0-52 0 H98 a26 26 0 0 0-52 0z" fill="{{ pal.accent }}"/>
        <path d="M84 30 c6-10 12-16 24-16 h48 c10 0 18 6 24 18z" fill="#fff" opacity=".92"/>
        <path d="M134 14 v18" stroke="{{ pal.accent }}" stroke-width="5"/>
        <rect x="4" y="52" width="14" height="10" rx="3" fill="#fff" opacity=".9"/>
        <circle cx="72" cy="80" r="24" fill="#0a1a30"/><circle cx="72" cy="80" r="10" fill="#cbd5e1"/>
        <circle cx="204" cy="80" r="24" fill="#0a1a30"/><circle cx="204" cy="80" r="10" fill="#cbd5e1"/>
        <rect x="120" y="-34" width="38" height="24" rx="5" fill="#fff"/>
        <text x="139" y="-16" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-weight="800" font-size="18" fill="{{ pal.primary }}">L</text>
      </g>
    </svg>
  </div>
  <div class="roadline"></div>
</div>

<div class="strip">
  <div class="wrap">
    {% if b.address %}<span>{{ icon('pin') }}{{ b.address }}</span>{% endif %}
    {% if b.phone %}<span>{{ icon('phone') }}<a href="tel:{{ b.phone_tel }}" style="text-decoration:none">{{ b.phone }}</a></span>{% endif %}
    <span>{{ icon('clock') }}{{ '[[Add your hours]]'|rich }}</span>
  </div>
</div>

<section id="lessons">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Programs</span><h2>{{ n.services_title }}</h2>
      <p>Pick what fits where you are right now. We help you get there. {{ '[[Edit programs to match your school]]'|rich }}</p></div>
    <div class="grid grid-4 svc">
      {% for ic, title, desc in n.services %}
      <div class="card"><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="steps" style="padding-top:8px">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">The process</span><h2>{{ n.steps_title }}</h2></div>
    <ol class="steps">
      {% for title, desc in n.steps %}<li><h3>{{ title }}</h3><p>{{ desc|rich }}</p></li>{% endfor %}
    </ol>
  </div>
</section>

<section class="pkg-wrap" id="packages">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Packages</span><h2>{{ n.extras.packages_title }}</h2>
      <p>{{ '[[Add your real packages and prices]]'|rich }}</p></div>
    <div class="grid grid-3">
      {% for name, hrs, blurb, pop in n.extras.packages %}
      <div class="card pkg {{ 'pop' if pop }}">
        {% if pop %}<span class="tag">Most popular</span>{% endif %}
        <h3>{{ name }}</h3>
        <div class="hrs">{{ hrs|rich }}</div>
        <p style="color:var(--muted)">{{ blurb }}</p>
        <div class="price">Contact for pricing</div>
        <a class="btn {{ 'btn-accent' if pop else 'btn-primary' }}" href="#contact">Ask about this</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="why">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Why us</span><h2>{{ n.extras.why_title }}</h2></div>
    <div class="grid grid-3">
      {% for ic, title, desc in n.extras.why %}
      <div><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc|rich }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap check">
    <div>
      <span class="eyebrow">Be ready</span>
      <h2 style="font-size:clamp(1.7rem,3.4vw,2.4rem)">{{ n.extras.checklist_title }}</h2>
      <p style="color:var(--muted);margin-top:10px">A short list so test day goes smoothly. {{ '[[Edit for your state]]'|rich }}</p>
    </div>
    <ul>{% for item in n.extras.checklist %}<li>{{ icon('check') }}<span>{{ item }}</span></li>{% endfor %}</ul>
  </div>
</section>

<section id="faq">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Questions</span><h2>Frequently asked questions</h2></div>
    {{ m.faq(n.faq) }}
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Get started</span><h2>Book a lesson in {{ b.city }}</h2>
      <p>Send a message or call and we will help you pick the right lessons.</p></div>
    <div class="contact-grid">
      <div>{{ m.info_list(b) }}{{ m.map_block(b) }}</div>
      <div class="card">{{ m.preview_form('Request a lesson') }}</div>
    </div>
  </div>
</section>
{% endblock %}
