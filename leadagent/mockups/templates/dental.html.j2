{% extends 'base.html.j2' %}
{# Design concept: "digital anesthetic" - airy pastel blobs, one long smile-curve motif, big radii, floating soft cards. #}
{% block css %}
/* ===== Dental: calm, invitational, organic ===== */
:root{--r-lg:28px;--soft:0 24px 50px -30px color-mix(in srgb,var(--primary) 55%,transparent)}
body{background:var(--bg)}
section{padding:88px 0}
@media (max-width:720px){section{padding:60px 0}}
.sec-head{max-width:620px}
.sec-head.c{margin-left:auto;margin-right:auto;text-align:center}
.sec-head h2{font-weight:800;letter-spacing:-.02em}
.eyebrow{color:var(--primary);background:var(--tint);padding:7px 14px;border-radius:999px;letter-spacing:.08em}
.card{border-radius:var(--r-lg)}

/* header: floating pill */
.top{position:sticky;top:0;z-index:40;padding:12px 0;background:linear-gradient(var(--bg) 60%,transparent)}
.top .bar{display:flex;align-items:center;gap:16px;min-height:64px;padding:8px 10px 8px 18px;background:var(--surface);border:1px solid var(--line);border-radius:999px;box-shadow:0 10px 30px -22px var(--primary)}
.logo{display:flex;align-items:center;gap:10px;font:800 1.05rem/1.1 var(--font-h);text-decoration:none;min-width:0;color:var(--ink)}
.logo .mark{display:grid;place-items:center;width:38px;height:38px;border-radius:50% 50% 50% 12px;background:var(--primary);color:var(--on-primary);flex:none;font-size:1.15rem}
.logo .t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.top nav{margin-left:auto;display:flex;gap:6px;font:600 .92rem var(--font-b)}
.top nav a{white-space:nowrap;text-decoration:none;color:var(--muted);padding:10px 10px;border-radius:999px}
.top nav a:hover{background:var(--tint);color:var(--ink)}
.top .tel{display:inline-flex;align-items:center;gap:8px;font-weight:700;text-decoration:none;padding:10px 14px;min-height:44px;white-space:nowrap;color:var(--primary)}
.top .btn{padding:12px 20px;font-size:.92rem;white-space:nowrap}
@media (max-width:1180px){.top nav{display:none}.top .tel{margin-left:auto}}
@media (max-width:620px){.top .tel span{display:none}.top .btn{display:none}.top .tel{padding:0;width:44px;justify-content:center;background:var(--tint);border-radius:50%;font-size:1.15rem}}

/* hero */
.hero{position:relative;overflow:hidden;padding:36px 0 70px;background:
  linear-gradient(var(--bg),transparent 140px),linear-gradient(transparent calc(100% - 140px),var(--bg)),
  radial-gradient(60% 70% at 88% 12%,color-mix(in srgb,var(--accent) 22%,transparent),transparent 70%),
  radial-gradient(55% 65% at 8% 90%,var(--tint),transparent 70%),
  radial-gradient(45% 55% at 60% 55%,color-mix(in srgb,var(--primary) 9%,transparent),transparent 70%)}
.hero .wrap{display:grid;gap:40px;grid-template-columns:1.05fr .95fr;align-items:center}
.hero h1{font-size:clamp(2.3rem,5.2vw,3.9rem);font-weight:800;letter-spacing:-.03em;line-height:1.06}
.hero .sub{font-size:1.2rem;color:var(--muted);margin:20px 0 30px;max-width:34ch}
.ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero .btn{padding:16px 28px}
.hero .btn-ghost{color:var(--primary);border-color:color-mix(in srgb,var(--primary) 35%,transparent);background:var(--surface)}
.micro{display:flex;flex-wrap:wrap;gap:8px 22px;margin:26px 0 0;padding:0;list-style:none;color:var(--muted);font-weight:600;font-size:.92rem}
.micro li{display:flex;align-items:center;gap:8px}
.micro .ic{color:var(--primary)}
.art{position:relative;width:100%;max-width:520px;margin:0 auto;aspect-ratio:1/1}
.art svg.bg{position:absolute;inset:0;width:100%;height:100%}
.fc{position:absolute;display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:12px 16px;font:700 .9rem/1.25 var(--font-b);box-shadow:var(--soft);animation:bob 6s ease-in-out infinite}
.fc .icon-badge{width:38px;height:38px;border-radius:50%;font-size:1.1rem}
.fc small{display:block;font-weight:500;color:var(--muted);font-size:.78rem}
.fc.a{left:-2%;top:16%}
.fc.b{right:-2%;bottom:20%;animation-delay:-3s}
.fc.c{left:14%;bottom:4%;animation-delay:-1.5s}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@media (max-width:900px){.hero .wrap{grid-template-columns:1fr}.art{max-width:400px}.fc.a{left:0}.fc.b{right:0}}
@media (max-width:480px){.fc{padding:9px 12px;font-size:.8rem}.fc .icon-badge{width:32px;height:32px}.fc.c{display:none}}
@media (prefers-reduced-motion:reduce){.fc{animation:none}}

/* quick info strip */
.qi{margin-top:-34px;position:relative;z-index:2;padding:0}
.qi .grid{gap:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--soft);overflow:hidden;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr))}
.qi .it{display:flex;gap:14px;align-items:center;padding:20px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);margin:0 -1px -1px 0;min-width:0}
.qi .icon-badge{border-radius:50%;flex:none}
.qi small{display:block;color:var(--muted);font-size:.74rem;text-transform:uppercase;letter-spacing:.09em;font-weight:700}
.qi a{text-decoration:none;font-weight:700}
.qi b{font-weight:700}

/* services */
.svc .card{display:grid;gap:12px;align-content:start;padding:26px;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}
.svc .card::after{content:"";position:absolute;right:-34px;top:-34px;width:110px;height:110px;border-radius:50%;background:var(--tint);opacity:.7;transition:transform .3s}
.svc .card:hover{transform:translateY(-4px);box-shadow:var(--soft)}
.svc .card:hover::after{transform:scale(1.25)}
.svc .icon-badge{border-radius:18px 18px 18px 6px;width:52px;height:52px;position:relative;z-index:1;background:var(--tint)}
.svc h3{font-size:1.08rem;position:relative;z-index:1}
.svc p{color:var(--muted);font-size:.95rem;position:relative;z-index:1}

/* first visit timeline */
.visit{background:linear-gradient(var(--bg),var(--tint) 20%,var(--tint) 80%,var(--bg))}
.visit .wrap{display:grid;gap:48px;grid-template-columns:.8fr 1.2fr;align-items:start}
.visit .lead{position:sticky;top:110px}
.visit .lead p{color:var(--muted);margin-top:12px}
.tl{list-style:none;margin:0;padding:0;counter-reset:t;position:relative;display:grid;gap:22px}
.tl::before{content:"";position:absolute;left:29px;top:30px;bottom:30px;width:0;border-left:3px dotted color-mix(in srgb,var(--primary) 45%,transparent)}
.tl li{position:relative;display:grid;grid-template-columns:60px 1fr;gap:18px;align-items:start}
.tl li::before{counter-increment:t;content:counter(t);width:60px;height:60px;border-radius:50%;background:var(--primary);color:var(--on-primary);display:grid;place-items:center;font:800 1.3rem var(--font-h);box-shadow:0 0 0 7px var(--tint);position:relative;z-index:1}
.tl .card{padding:20px 24px;box-shadow:var(--soft)}
.tl h3{font-size:1.1rem;margin-bottom:6px}
.tl p{color:var(--muted)}
@media (max-width:900px){.visit .wrap{grid-template-columns:1fr;gap:32px}.visit .lead{position:static}}
@media (max-width:480px){.tl li{grid-template-columns:44px 1fr;gap:12px}.tl li::before{width:44px;height:44px;font-size:1.05rem;box-shadow:0 0 0 5px var(--tint)}.tl::before{left:21px}.tl .card{padding:16px 18px}}

/* insurance */
.ins{position:relative;overflow:hidden;display:grid;gap:28px;grid-template-columns:1.1fr .9fr;align-items:center;padding:44px;background:var(--surface);border:1px solid var(--line);border-radius:36px}
.ins::before{content:"";position:absolute;left:-60px;bottom:-90px;width:320px;height:320px;border-radius:46% 54% 60% 40%;background:var(--tint);opacity:.8}
.ins>*{position:relative}
.ins h2{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:800;letter-spacing:-.02em;margin:0 0 12px}
.ins p{color:var(--muted);font-size:1.05rem}
.tags{display:flex;flex-wrap:wrap;gap:12px;padding:0;margin:0;list-style:none}
.tags li{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:12px 18px;font-weight:600}
.ins .note{margin-top:16px;font-size:.84rem}
@media (max-width:820px){.ins{grid-template-columns:1fr;padding:30px 22px}}

/* emergency band */
.emerg{padding:0}
.emerg .band{position:relative;overflow:hidden;display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:space-between;padding:38px 44px;border-radius:36px;background:color-mix(in srgb,var(--accent) 24%,var(--surface));border:1.5px solid color-mix(in srgb,var(--accent) 60%,var(--surface))}
.emerg .band::after{content:"";position:absolute;right:-50px;top:-70px;width:240px;height:240px;border-radius:50%;background:color-mix(in srgb,var(--accent) 30%,transparent)}
.emerg .txt{display:flex;gap:18px;align-items:center;position:relative;z-index:1;flex:1 1 380px;min-width:0}
.emerg .icon-badge{background:var(--accent);color:var(--on-accent);width:58px;height:58px;border-radius:50%;font-size:1.6rem;flex:none}
.emerg h2{text-wrap:balance;font-size:clamp(1.4rem,2.8vw,2rem);font-weight:800}
.emerg p{margin-top:6px;color:var(--ink);opacity:.85}
.emerg .btn{position:relative;z-index:1;background:var(--ink);color:var(--bg);padding:16px 28px}
.emerg .ph{background:rgba(255,255,255,.55)}
@media (max-width:620px){.emerg .band{padding:28px 22px}.emerg .txt{flex-direction:column;align-items:flex-start}.emerg .btn{width:100%}}

/* owner slots */
.slots{display:grid;gap:22px;grid-template-columns:1fr 1fr}
.slot{border:2px dashed color-mix(in srgb,var(--primary) 40%,var(--line));border-radius:var(--r-lg);padding:28px;background:color-mix(in srgb,var(--surface) 55%,transparent);display:grid;gap:12px;align-content:start}
.slot .k{display:flex;align-items:center;gap:12px;font:800 1.1rem var(--font-h)}
.slot .k .icon-badge{border-radius:50%}
.slot .fill{font-size:1.02rem}
.slot .gain{color:var(--muted);font-size:.9rem;border-top:1px dashed var(--line);padding-top:12px}
.slot.wide{grid-column:1/-1;grid-template-columns:auto 1fr;align-items:center;gap:28px}
.slot.wide .stars{display:flex;gap:4px;color:var(--accent);font-size:1.5rem}
.slot.wide .stars .ic{width:1.2em;height:1.2em}
.slot.wide .body{display:grid;gap:10px}
.avatar{width:96px;height:96px;border-radius:50%;background:var(--tint);display:grid;place-items:center;color:var(--primary);font-size:2.4rem;border:2px dashed color-mix(in srgb,var(--primary) 40%,var(--line))}
@media (max-width:760px){.slots{grid-template-columns:1fr}.slot.wide{grid-template-columns:1fr;gap:14px}.slot{padding:22px}}

/* contact */
.contact{background:linear-gradient(var(--bg),var(--tint));border-radius:48px 48px 0 0}
.contact .card{box-shadow:var(--soft);padding:28px}
.contact form.f input,.contact form.f select,.contact form.f textarea{border-radius:14px}
{% endblock %}

{% block body %}
<header class="top">
  <div class="wrap">
    <div class="bar">
      <a class="logo" href="#top"><span class="mark">{{ icon('tooth') }}</span><span class="t">{{ b.name }}</span></a>
      <nav aria-label="Main"><a href="#care">Services</a><a href="#visit">First visit</a><a href="#faq">FAQ</a><a href="#contact">Contact</a></nav>
      {% if b.phone_tel %}<a class="tel" href="tel:{{ b.phone_tel }}" aria-label="Call {{ b.phone }}">{{ icon('phone') }}<span>{{ b.phone }}</span></a>{% endif %}
      <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
    </div>
  </div>
</header>

<div class="hero" id="top">
  <div class="wrap">
    <div>
      <h1>{{ n.h1 }}</h1>
      <p class="sub">{{ n.sub }}</p>
      <div class="ctas">
        <a class="btn btn-accent" href="#contact">{{ n.cta_primary }}</a>
        {% if b.phone_tel %}<a class="btn btn-ghost" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} {{ n.cta_secondary }}</a>{% endif %}
      </div>
      <ul class="micro">
        <li>{{ icon('heart') }}New patients welcome</li>
        {% if b.address %}<li>{{ icon('pin') }}{{ b.address }}</li>{% elif b.city_state %}<li>{{ icon('pin') }}Serving {{ b.city_state }}</li>{% endif %}
      </ul>
    </div>
    <div class="art" aria-hidden="true">
      <svg class="bg" viewBox="0 0 520 520">
        <path d="M262 30c92-6 196 44 220 142 22 90-30 150-24 224 6 72-84 116-172 108-84-8-108-70-170-118C46 336 20 280 42 200 66 112 150 36 262 30z" fill="{{ pal.tint }}"/>
        <path d="M300 74c70 6 140 62 148 132 8 68-48 96-58 160-10 62-82 80-146 62-70-20-96-74-130-116-32-40-28-106 8-152 36-46 108-92 178-86z" fill="{{ pal.primary }}" opacity=".11"/>
        <circle cx="422" cy="98" r="54" fill="{{ pal.accent }}" opacity=".4"/>
        <circle cx="96" cy="430" r="30" fill="{{ pal.accent }}" opacity=".35"/>
        <circle cx="440" cy="440" r="12" fill="{{ pal.primary }}" opacity=".25"/>
        <circle cx="70" cy="120" r="9" fill="{{ pal.primary }}" opacity=".25"/>
        <!-- smile curve -->
        <path d="M110 250 C150 380 370 380 410 250" fill="none" stroke="{{ pal.primary }}" stroke-width="22" stroke-linecap="round"/>
        <path d="M138 262 C180 352 340 352 382 262" fill="none" stroke="{{ pal.accent }}" stroke-width="8" stroke-linecap="round" opacity=".95"/>
        <circle cx="196" cy="206" r="15" fill="{{ pal.primary }}"/><circle cx="324" cy="206" r="15" fill="{{ pal.primary }}"/>
        <path d="M60 470 C140 440 200 490 280 470 S420 450 470 478" fill="none" stroke="{{ pal.primary }}" stroke-width="3" stroke-linecap="round" opacity=".2"/>
      </svg>
      <div class="fc a"><span class="icon-badge">{{ icon('heart') }}</span><div>New patients welcome<small>Family friendly</small></div></div>
      <div class="fc b"><span class="icon-badge">{{ icon('calendar') }}</span><div>Request a visit online<small>Or give us a call</small></div></div>
      <div class="fc c"><span class="icon-badge">{{ icon('sparkle') }}</span><div>{{ (b.city ~ ' dental care') if b.city else 'Local dental care' }}</div></div>
    </div>
  </div>
</div>

<div class="qi">
  <div class="wrap">
    <div class="grid">
      {% if b.address %}<div class="it"><span class="icon-badge">{{ icon('pin') }}</span><div><small>Visit</small><b>{{ b.address }}</b></div></div>{% endif %}
      {% if b.phone %}<div class="it"><span class="icon-badge">{{ icon('phone') }}</span><div><small>Call</small><a href="tel:{{ b.phone_tel }}">{{ b.phone }}</a></div></div>{% endif %}
      <div class="it"><span class="icon-badge">{{ icon('clock') }}</span><div><small>Hours</small>{{ n.extras.hours_placeholder|rich }}</div></div>
      <div class="it"><span class="icon-badge">{{ icon('heart') }}</span><div><small>Patients</small><b>New patients welcome</b></div></div>
    </div>
  </div>
</div>

<section id="care">
  <div class="wrap">
    <div class="sec-head c"><span class="eyebrow">Our care</span><h2>{{ n.services_title }}</h2>
      <p>{{ '[[Edit services to match your practice]]'|rich }}</p></div>
    <div class="grid grid-4 svc">
      {% for ic, title, desc in n.services %}
      <div class="card"><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="visit" id="visit">
  <div class="wrap">
    <div class="lead">
      <span class="eyebrow">Nothing to worry about</span>
      <h2 style="font-size:clamp(1.8rem,3.6vw,2.6rem);font-weight:800;letter-spacing:-.02em">{{ n.steps_title }}</h2>
      <p>Three simple steps, at your pace. Ask us anything along the way.</p>
      <a class="btn btn-primary" style="margin-top:22px" href="#contact">{{ n.cta_primary }}</a>
    </div>
    <ol class="tl">
      {% for title, desc in n.steps %}<li><div class="card"><h3>{{ title }}</h3><p>{{ desc|rich }}</p></div></li>{% endfor %}
    </ol>
  </div>
</section>

<section id="insurance" style="padding-top:40px">
  <div class="wrap">
    <div class="ins">
      <div>
        <span class="eyebrow">Coverage &amp; payment</span>
        <h2>Insurance and payment</h2>
        <p>{{ n.extras.insurance|rich }}</p>
        <p class="note">{{ '[[Confirm accepted plans before publishing]]'|rich }}</p>
      </div>
      <ul class="tags">
        {% for t in n.extras.insurance_tags %}<li>{{ t|rich }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="emerg">
  <div class="wrap">
    <div class="band">
      <div class="txt">
        <span class="icon-badge">{{ icon('alert') }}</span>
        <div><h2>{{ n.extras.emergency }}</h2><p>{{ n.extras.emergency_sub|rich }}</p></div>
      </div>
      {% if b.phone_tel %}<a class="btn" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} Call {{ b.phone }}</a>{% else %}<a class="btn" href="#contact">{{ n.cta_primary }}</a>{% endif %}
    </div>
  </div>
</section>

<section id="practice">
  <div class="wrap">
    <div class="sec-head c"><span class="eyebrow">Make it yours</span><h2>Space for your practice</h2>
      <p>These blocks are filled in by the practice. They are what make a website feel like you.</p></div>
    <div class="slots">
      <div class="slot">
        <div class="k"><span class="icon-badge">{{ icon('sparkle') }}</span>New-patient offer</div>
        <div class="fill">{{ n.extras.offer_placeholder|rich }}</div>
        <div class="gain">A clear first-visit offer gives new visitors a reason to book today.</div>
      </div>
      <div class="slot">
        <div class="k"><span class="icon-badge">{{ icon('user') }}</span>Meet the dentist</div>
        <div class="fill">{{ n.extras.team_placeholder|rich }}</div>
        <div class="gain">A friendly face and short bio helps nervous patients feel at ease before they arrive.</div>
      </div>
      <div class="slot wide">
        <div class="avatar">{{ icon('star') }}</div>
        <div class="body">
          <div class="k">Patient reviews</div>
          <div class="fill">{{ n.extras.reviews_placeholder|rich }}</div>
          <div class="gain" style="border:0;padding:0">Real words from your own patients, pulled in from your Google listing, build trust at a glance.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="faq" style="padding-top:20px">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Questions</span><h2>Frequently asked questions</h2></div>
    {{ m.faq(n.faq) }}
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">Say hello</span><h2>Request an appointment in {{ b.city }}</h2>
      <p>Send a message or call and we will find a time that works.</p></div>
    <div class="contact-grid">
      <div>{{ m.info_list(b, hours=n.extras.hours_placeholder) }}{{ m.map_block(b) }}</div>
      <div class="card">{{ m.preview_form(n.cta_primary) }}</div>
    </div>
  </div>
</section>
{% endblock %}
