{# Gym: "the floor, loud" - giant outlined city word, lime/ember slashes, program ticker, timetable + tier cards on near-black #}
{% extends 'base.html.j2' %}
{% block css %}
h1,h2,h3,h4{font-weight:400;text-transform:uppercase;letter-spacing:.03em}
.sec-head h2{font-size:clamp(2.1rem,5vw,3.4rem);line-height:1}
.eyebrow{color:var(--accent)}
.slash{display:inline-block;width:34px;height:10px;background:var(--accent);transform:skewX(-30deg);margin-right:10px;vertical-align:middle}
.card{border-radius:4px}
.icon-badge{border-radius:4px;background:var(--accent);color:var(--on-accent)}
.btn{border-radius:4px;text-transform:uppercase;letter-spacing:.06em;min-height:48px;font-weight:800}
.btn-ghost{border-color:var(--line);border-width:2px;color:var(--ink)}
.btn-ghost:hover{border-color:var(--accent)}
.ph{color:var(--ink)}

.top{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;gap:22px;min-height:68px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;font:400 1.35rem/1 var(--font-h);text-transform:uppercase;letter-spacing:.05em;min-width:0}
.logo .mark{display:grid;place-items:center;flex:none;width:40px;height:40px;background:var(--accent);color:var(--on-accent);font-size:1.15rem;clip-path:polygon(18% 0,100% 0,82% 100%,0 100%)}
.logo .t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.top nav{margin-left:auto;display:flex;gap:24px;font:700 .82rem var(--font-b);text-transform:uppercase;letter-spacing:.1em}
.top nav a{text-decoration:none;color:var(--muted);padding:12px 0}
.top nav a:hover{color:var(--ink)}
.top .tel{display:none;text-decoration:none;font-weight:700;white-space:nowrap}
.top .btn{padding:12px 18px;font-size:.85rem;white-space:nowrap}
@media (min-width:1000px){.top .tel{display:inline-flex;gap:8px;align-items:center}}
@media (max-width:860px){.top nav{display:none}.top .btn{margin-left:auto}}

/* hero */
.hero{position:relative;overflow:hidden;padding:64px 0 0;background:var(--bg)}
.hero::before{content:"";position:absolute;right:-8%;top:0;bottom:0;width:46%;background:var(--surface);transform:skewX(-14deg);border-left:6px solid var(--accent)}
.hero .bigword{position:absolute;left:0;right:0;bottom:64px;font:400 clamp(5rem,17vw,16rem)/.8 var(--font-h);text-transform:uppercase;white-space:nowrap;color:transparent;-webkit-text-stroke:2px var(--line);pointer-events:none;user-select:none;opacity:.9;padding-left:12px}
.hero .wrap{position:relative;z-index:1;padding-bottom:110px}
.offer{display:inline-block;background:var(--accent);color:var(--on-accent);font:800 .95rem/1.2 var(--font-b);text-transform:uppercase;letter-spacing:.08em;padding:10px 18px 10px 14px;clip-path:polygon(0 0,100% 0,calc(100% - 12px) 100%,0 100%);margin-bottom:22px}
.offer .ph{color:var(--on-accent);border-color:var(--on-accent);background:rgba(0,0,0,.08);opacity:1}
.hero h1{font-size:clamp(3rem,9vw,6.4rem);line-height:.95;max-width:11ch}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero .sub{font-size:1.15rem;color:var(--ink);opacity:.85;margin:22px 0 28px;max-width:34ch}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px}
.chips{display:flex;flex-wrap:wrap;gap:10px;list-style:none;margin:28px 0 0;padding:0}
.chips li{display:flex;align-items:center;gap:8px;font:700 .8rem var(--font-b);text-transform:uppercase;letter-spacing:.08em;padding:9px 14px;border:1px solid var(--line);background:var(--bg)}
.chips .ic{color:var(--accent)}
.dumb{position:absolute;right:4%;top:50%;transform:translateY(-58%) rotate(-12deg);width:min(38vw,440px);z-index:0;opacity:.95}
@media (max-width:860px){.hero{padding-top:44px}.hero::before{display:none}.logo{font-size:1.1rem}.logo .mark{width:34px;height:34px}.top .wrap{gap:12px}.top .btn{padding:12px 14px}.dumb{display:none}.hero .wrap{padding-bottom:96px}.hero .bigword{bottom:40px}}

.tickwrap{overflow:hidden;margin-top:-40px;position:relative;z-index:2;padding:18px 0}
.ticker{background:var(--accent);color:var(--on-accent);overflow:hidden;white-space:nowrap;transform:rotate(-1.2deg);margin:0 -20px;border-block:3px solid var(--bg)}
.ticker .track{display:inline-flex;animation:tick 32s linear infinite;padding:12px 0}
.ticker span{font:400 1.5rem/1 var(--font-h);text-transform:uppercase;letter-spacing:.06em;padding:0 22px;display:inline-flex;align-items:center;gap:44px}
.ticker span::after{content:"";width:12px;height:12px;background:var(--on-accent);transform:skewX(-30deg)}
@keyframes tick{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.ticker .track{animation:none}.ticker{overflow-x:auto}}

/* why */
.why{padding-top:96px}
.why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));border:1px solid var(--line)}
.why-grid div{padding:28px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);margin:0 -1px -1px 0}
.why-grid .num{font:400 3rem/1 var(--font-h);color:transparent;-webkit-text-stroke:1.5px var(--accent);float:right}
.why-grid h3{font-size:1.3rem;margin:16px 0 8px}
.why-grid p{color:var(--muted);font-size:.94rem}

/* programs */
.prog{background:var(--tint);border-block:1px solid var(--line)}
.prog .card{position:relative;overflow:hidden;display:grid;gap:12px;align-content:start;padding:24px 22px 26px;transition:transform .18s,border-color .18s}
.prog .card::after{content:"";position:absolute;right:-26px;top:-26px;width:60px;height:60px;background:var(--accent);transform:rotate(45deg);opacity:0;transition:opacity .18s}
.prog .card:hover{transform:translateY(-4px);border-color:var(--accent)}
.prog .card:hover::after{opacity:1}
.prog h3{font-size:1.3rem}
.prog p{color:var(--muted);font-size:.94rem}

/* schedule */
.tt-note{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-bottom:16px;font-size:.88rem;color:var(--muted)}
.tt-tag{background:var(--accent);color:var(--on-accent);font:800 .72rem/1 var(--font-b);letter-spacing:.1em;text-transform:uppercase;padding:6px 10px}
.tt-scroll{overflow-x:auto;border:1px solid var(--line);background:var(--surface)}
table.tt{border-collapse:collapse;width:100%;min-width:720px}
.tt th,.tt td{padding:14px 10px;text-align:center;border:1px solid var(--line);font-size:.92rem}
.tt thead th{font:400 1.1rem var(--font-h);letter-spacing:.08em;text-transform:uppercase;background:var(--bg)}
.tt tbody th{font:800 .8rem var(--font-b);text-align:left;white-space:nowrap;color:var(--accent);background:var(--bg);padding-left:16px}
.tt td{font-weight:600;cursor:text}
.tt td:hover{background:var(--tint)}
.tt td.off{color:var(--muted);font-weight:400}
.tt-hint{display:none;font-size:.8rem;color:var(--muted);margin-top:8px}
@media (max-width:820px){.tt-hint{display:block}}

/* tiers */
.tiers-wrap{background:var(--tint);border-block:1px solid var(--line)}
.tier{display:flex;flex-direction:column;gap:14px;position:relative;padding:28px 24px}
.tier h3{font-size:1.5rem}
.tier .price{font:400 3rem/1 var(--font-h);letter-spacing:.02em;color:var(--ink)}
.tier ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;flex:1}
.tier li{display:flex;gap:10px;align-items:flex-start;font-size:.95rem}
.tier li .ic{color:var(--accent);margin-top:.2em}
.tier.pop{background:var(--bg);border:2px solid var(--accent);box-shadow:0 0 0 6px rgba(127,127,127,.08)}
@media (min-width:900px){.tier.pop{transform:translateY(-14px)}}
.tier .tag{position:absolute;top:-14px;left:20px;background:var(--accent);color:var(--on-accent);font:800 .72rem/1 var(--font-b);letter-spacing:.1em;text-transform:uppercase;padding:8px 12px;clip-path:polygon(0 0,100% 0,calc(100% - 8px) 100%,0 100%)}
.tiers-wrap .grid{padding-top:14px}

/* steps */
.steps{list-style:none;margin:0;padding:0;display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));counter-reset:s}
.steps li{position:relative;padding:76px 24px 24px;border:1px solid var(--line);background:var(--surface);overflow:hidden}
.steps li::before{counter-increment:s;content:"0" counter(s);position:absolute;left:20px;top:10px;font:400 3.6rem/1 var(--font-h);color:transparent;-webkit-text-stroke:1.5px var(--accent);opacity:.8}
.steps h3{font-size:1.4rem;margin-bottom:8px}
.steps p{color:var(--muted)}

/* owner slots */
.slots{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}
.slot{border:2px dashed var(--line);padding:28px 24px;display:grid;gap:12px;align-content:start;min-height:190px}
.slot h3{font-size:1.3rem}
.slot .ic-big{color:var(--accent);font-size:1.8rem}
.toggle{display:inline-flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line);padding:8px 16px 8px 8px;border-radius:999px;font-weight:700}
.toggle i{width:46px;height:26px;border-radius:999px;background:var(--accent);position:relative;flex:none}
.toggle i::after{content:"";position:absolute;right:3px;top:3px;width:20px;height:20px;border-radius:50%;background:var(--on-accent)}

/* final */
.band{background:var(--accent);color:var(--on-accent);position:relative;overflow:hidden}
.band .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;padding-top:56px;padding-bottom:56px}
.band h2{font-size:clamp(2.2rem,6vw,4.2rem);line-height:.95;max-width:18ch}
.band .btn{background:var(--on-accent);color:var(--accent)}
.band .btn-ghost{background:transparent;color:var(--on-accent);border-color:var(--on-accent)}
.band .ctas{display:flex;flex-wrap:wrap;gap:12px}
.contact{background:var(--bg)}
.contact .card{padding:28px 24px}
{% endblock %}

{% block body %}
{% set e = n.extras %}
<header class="top">
  <div class="wrap">
    <a class="logo" href="#top"><span class="mark">{{ icon('dumbbell') }}</span><span class="t">{{ b.name }}</span></a>
    <nav aria-label="Main"><a href="#programs">Programs</a><a href="#schedule">Schedule</a><a href="#memberships">Memberships</a><a href="#faq">FAQ</a><a href="#contact">Contact</a></nav>
    {% if b.phone_tel %}<a class="tel" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} {{ b.phone }}</a>{% endif %}
    <a class="btn btn-accent" href="#contact">Try us free</a>
  </div>
</header>

<div class="hero" id="top">
  <div class="bigword" aria-hidden="true">{{ b.city }}</div>
  <svg class="dumb" viewBox="0 0 400 200" aria-hidden="true">
    <g fill="none" stroke="{{ pal.accent }}" stroke-width="6" stroke-linejoin="round">
      <rect x="20" y="60" width="34" height="80" rx="4"/><rect x="62" y="36" width="42" height="128" rx="4" fill="{{ pal.accent }}" fill-opacity=".18"/>
      <rect x="104" y="92" width="192" height="16"/>
      <rect x="296" y="36" width="42" height="128" rx="4" fill="{{ pal.accent }}" fill-opacity=".18"/><rect x="346" y="60" width="34" height="80" rx="4"/>
    </g>
  </svg>
  <div class="wrap">
    <div class="offer">{{ n.offer_badge|rich }}</div>
    <h1>{{ n.h1 }}</h1>
    <p class="sub">{{ n.sub }}</p>
    <div class="ctas">
      <a class="btn btn-accent" href="#contact">{{ n.cta_primary }} {{ icon('arrow') }}</a>
      <a class="btn btn-ghost" href="#memberships">{{ n.cta_secondary }}</a>
    </div>
    <ul class="chips">{% for c in n.chips %}<li>{{ icon('check') }}{{ c }}</li>{% endfor %}</ul>
  </div>
</div>

<div class="tickwrap"><div class="ticker" aria-hidden="true"><div class="track">
  {% for k in range(2) %}{% for ic, title, desc in n.services %}<span>{{ title }}</span>{% endfor %}{% endfor %}
</div></div></div>

<section class="why">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Why train here</span><h2>Built to keep you coming back</h2></div>
    <div class="why-grid">
      {% for ic, title, desc in [n.services[3], n.services[2], n.services[5], n.services[7]] %}
      <div><span class="num">0{{ loop.index }}</span><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="prog" id="programs">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Programs</span><h2>{{ n.services_title }}</h2>
      <p>{{ '[[Edit programs to match your gym]]'|rich }}</p></div>
    <div class="grid grid-4">
      {% for ic, title, desc in n.services %}
      <div class="card"><span class="icon-badge">{{ icon(ic) }}</span><h3>{{ title }}</h3><p>{{ desc }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="schedule">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Timetable</span><h2>{{ e.schedule_title }}</h2></div>
    <div class="tt-note"><span class="tt-tag">Sample</span><span>Placeholder timetable. {{ '[[Replace with your real class times]]'|rich }}</span></div>
    <div class="tt-scroll">
      <table class="tt">
        <thead><tr><th scope="col"><span class="sr" style="position:absolute;left:-9999px">Time</span></th>{% for d in e.schedule_days %}<th scope="col">{{ d }}</th>{% endfor %}</tr></thead>
        <tbody>
          {% for time, row in e.schedule %}
          <tr><th scope="row">{{ time }}</th>{% for cell in row %}<td class="{{ 'off' if cell in ('Rest',) }}">{{ cell }}</td>{% endfor %}</tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="tt-hint">Swipe sideways to see the whole week.</p>
  </div>
</section>

<section class="tiers-wrap" id="memberships">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Plans</span><h2>{{ e.tiers_title }}</h2>
      <p>{{ '[[Add your real plans and prices]]'|rich }}</p></div>
    <div class="grid grid-3">
      {% for name, price, items, pop in e.tiers %}
      <div class="card tier {{ 'pop' if pop }}">
        {% if pop %}<span class="tag">Most popular</span>{% endif %}
        <h3>{{ name }}</h3>
        <div class="price">{{ price }}</div>
        <ul>{% for it in items %}<li>{{ icon('check') }}<span>{{ it|rich }}</span></li>{% endfor %}</ul>
        <a class="btn {{ 'btn-accent' if pop else 'btn-ghost' }}" href="#contact">Ask about {{ name }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="steps">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Get going</span><h2>{{ n.steps_title }}</h2></div>
    <ol class="steps">{% for title, desc in n.steps %}<li><h3>{{ title }}</h3><p>{{ desc|rich }}</p></li>{% endfor %}</ol>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Your gym, your details</span><h2>Meet the crew</h2></div>
    <div class="slots">
      <div class="slot"><span class="ic-big">{{ icon('users') }}</span><h3>Coaches</h3><p>{{ e.coaches_placeholder|rich }}</p></div>
      <div class="slot"><span class="ic-big">{{ icon('star') }}</span><h3>Member reviews</h3><p>{{ e.reviews_placeholder|rich }}</p></div>
      <div class="slot"><span class="ic-big">{{ icon('clock') }}</span><h3>Opening hours</h3>
        <div><span class="toggle"><i></i><span>{{ e.hours_badge|rich }}</span></span></div></div>
    </div>
  </div>
</section>

<section id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Questions</span><h2>Before you lace up</h2></div>
    {{ m.faq(n.faq) }}
  </div>
</section>

<section class="contact" id="contact" style="padding-bottom:64px">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow"><i class="slash"></i>Find us</span><h2>Claim your free pass</h2>
      <p>Leave your details and we will be in touch. {{ n.offer_badge|rich }}</p></div>
    <div class="contact-grid">
      <div>{{ m.info_list(b, hours=e.hours_badge) }}{{ m.map_block(b) }}</div>
      <div class="card">{{ m.preview_form('Claim my free pass') }}</div>
    </div>
  </div>
</section>

<div class="band">
  <div class="wrap">
    <h2>Your first session starts here</h2>
    <div class="ctas">
      <a class="btn" href="#contact">{{ n.cta_primary }}</a>
      {% if b.phone_tel %}<a class="btn btn-ghost" href="tel:{{ b.phone_tel }}">{{ icon('phone') }} {{ b.phone }}</a>{% endif %}
    </div>
  </div>
</div>
{% endblock %}
